PORT=5000
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=AUTH_PROJECT
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173
ATTENDANCE_START_TIME=09:00
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# AI Agent configuration (Groq / OpenAI-compatible endpoint)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_groq_api_key_here
AGENT_MODEL=openai/gpt-oss-20b

# Email delivery configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Snowflex" <your_email@gmail.com>

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:5173

# Live Chat Configuration
ALLOW_ADMIN_TO_ADMIN_CHAT=false
CHAT_RATE_LIMIT=20